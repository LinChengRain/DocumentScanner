    <!-- 首页 -->
    <string name="main_headline">把手机变成随身扫描仪</string>
    <string name="main_subheadline">自动识别文档边框 · 透视矫正 · 一键去阴影，效果接近系统级扫描</string>
    <string name="main_start">开始新扫描</string>
    <string name="main_history_title">历史会话</string>
